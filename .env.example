# Copy this file to .env and fill in real values. .env is git-ignored; this template is committed.
# Never commit real credentials.

# --- Database (Neon Postgres + pgvector) ---------------------------------------
# Neon console -> your project -> Connect -> connection pooling OFF ("direct").
# Take the string Neon gives you (postgresql://...) and change the prefix to
# postgresql+psycopg:// so SQLAlchemy uses the psycopg 3 driver. Keep ?sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional, for later: same database with connection pooling ON (host contains "-pooler").
# Useful for the deployed API; migrations must always use the direct URL above.
DATABASE_URL_POOLED=

# --- API -----------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- LLM (not needed until the conversation phase) -------------------------------
ANTHROPIC_API_KEY=
